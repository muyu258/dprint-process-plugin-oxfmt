{
  "nodeModulesDir": "manual",
  "nodeModulesLinker": "hoisted",
  "imports": {
    "@dprint/automation": "jsr:@dprint/automation@0.12.2",
    "@std/assert": "jsr:@std/assert@1.0.14",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/fs/move": "jsr:@std/fs@1.0.24/move",
    "@std/path": "jsr:@std/path@1.1.6",
    "@types/node": "npm:@types/node@20.19.0",
    "oxfmt": "npm:oxfmt@0.59.0",
    "typescript": "npm:typescript@7.0.2",
    "zod": "npm:zod@^4.4.3"
  },
  "tasks": {
    "fmt": "deno run -A --frozen npm:oxfmt@0.59.0 runtime/src --write",
    "fmt:check": "deno run -A --frozen npm:oxfmt@0.59.0 runtime/src --check",
    "runtime:build": "deno run -A --frozen npm:typescript@7.0.2/tsc --project runtime/tsconfig.json",
    "runtime:test": "deno run -A --frozen npm:typescript@7.0.2/tsc --project runtime/tsconfig.json --outDir runtime/dist-test && node --test runtime/dist-test/worker.test.js"
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "include": ["scripts/"]
  }
}
