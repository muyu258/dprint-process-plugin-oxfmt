{
  "compilerOptions": {
    "declaration": true,
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmitOnError": true,
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "strict": true,
    "target": "ES2023",
    "types": ["node"],
  },
  "include": ["src/**/*.ts"],
}
